# Token único obrigatório para autenticar requisições em POST /ocr
# Gere um valor aleatório forte, por exemplo:
#   openssl rand -hex 32
API_TOKEN=altere-este-token-para-um-valor-secreto

# Dispositivo PyTorch (mantenha cpu para este deploy)
TORCH_DEVICE=cpu

# Tamanho máximo do PDF em megabytes
MAX_UPLOAD_MB=50

# Porta publicada no host (mapeada no docker compose)
PORT=8000
