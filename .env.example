# Token único obrigatório para autenticar requisições
# Gere um valor aleatório forte, por exemplo:
#   openssl rand -hex 32
API_TOKEN=altere-este-token-para-um-valor-secreto

# Tamanho máximo do upload em megabytes
MAX_UPLOAD_MB=50

# Porta publicada no host (mapeada no docker compose)
PORT=8000

# DPI ao renderizar a página para OCR (250 é um bom equilíbrio precisão/CPU)
OCR_DPI=250

# force_ocr=true aplica OCR mesmo com texto digital (mais lento; use só se o texto nativo for ruim)
FORCE_OCR=false

# OpenAI — necessário para POST /to-xlsx quando houver IA (schema=ia, PDF/JPG bagunçado, etc.)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=120
# Limite de caracteres do texto enviado à IA (extratos grandes são truncados)
OPENAI_MAX_CHARS=100000
